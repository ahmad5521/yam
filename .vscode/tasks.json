{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "uninstall",
            "type": "shell",
            "command": "sudo",
            "args": [
                "bash",
                "./scripts/uninstall.sh"
            ]
        },
        {
            "label": "build",
            "type": "shell",
            "command": "bash",
            "args": [
                "./scripts/build.sh"
            ]
        },
        {
            "label": "install",
            "type": "shell",
            "command": "sudo",
            "args": [
                "bash",
                "./scripts/install.sh"
            ]
        },
        {
            "label": "full-deploy",
            "dependsOrder": "sequence",
            "dependsOn": [
                "uninstall",
                "build",
                "install"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}